# OAuth Outlook Configuration
#
# Copy this file to .env and fill in your Microsoft application credentials
# Register your application at: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps

# Microsoft Application (Client) ID
OUTLOOK_CLIENT_ID=your-client-id-here

# Microsoft Application Client Secret
OUTLOOK_CLIENT_SECRET=your-client-secret-here

# OAuth Redirect URI (must match the one registered in Azure)
OUTLOOK_REDIRECT_URI=http://localhost:8080/callback

# Optional: Custom token storage path
# TOKEN_STORAGE_PATH=./oauth_tokens.json
